node_modules/
.DS_Store

# apps/web/dist/ es el build de Vite (vite-plugin-singlefile): un artefacto
# generado, no un archivo commiteado. Se genera con `npm run build` y Vercel
# lo reconstruye en el deploy.
apps/web/dist/
.vercel/

# claves de Resend/otras — nunca se commitean, se cargan en el dashboard de Vercel.
.env
.env.local
.env*.local

# Maquetas de diseño locales — exploración visual, nunca se commitea ni se despliega.
/mockup-rediseno/

# Vault de Obsidian del asistente (notas de proyecto/proceso, ver
# obsidian-vault/The Hifi Match.md) — vive dentro del repo por comodidad,
# pero nunca se commitea: .obsidian/ trae la API key del plugin Local REST
# API en texto plano.
/obsidian-vault/
