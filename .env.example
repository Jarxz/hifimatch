# Variables de entorno de api/contact.ts — se cargan en Vercel (Project
# Settings → Environment Variables), nunca en un archivo commiteado.
# Ver CLAUDE.md, sección del formulario de contacto, para el runbook completo.

# API key de Resend (resend.com) — cuenta en plan Free, sin método de pago
# cargado, para que el tope de 100 emails/día sea un circuit-breaker real.
RESEND_API_KEY=

# A qué dirección llegan las consultas del formulario.
CONTACT_TO_EMAIL=

# Opcional — remitente de los emails enviados. Mientras thehifimatch.com no
# esté verificado en Resend (Resend → Domains), se usa el dominio de
# pruebas de Resend por defecto (onboarding@resend.dev) y esta variable
# puede quedar sin definir.
CONTACT_FROM_EMAIL=
